<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The tests that assert "allocates nothing" (BurstRenderer, HeaderCode, the station) failed now and then under load by a few kilobytes
         with tiered compilation on, and not once in 25 runs under the same load with it off; so they run with it off. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vectors the prototype generated for the link codecs, the payload code and the receivers. -->
    <None Include="Vectors/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Vectors/*.bin.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/M0LTE.OfdmFm/M0LTE.OfdmFm.csproj" />
  </ItemGroup>

</Project>
